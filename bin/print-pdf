#!/usr/bin/env bash
# Regenerate the downloadable PDFs from the live layout:
#   CV-Augustin-Riedinger-French.pdf  ← /
#   CV-Augustin-Riedinger-English.pdf ← /en/
# Builds the site into a temporary folder (so a running `jekyll serve`, which rebuilds _site whenever
# a PDF is written, can't interfere), serves it on a local port, checks the content fits the A4 sheet
# (each page is a .sheet that clips overflow silently, so clipped content would never show up in the page
# count), prints each page with headless Chrome, and fails if a PDF doesn't have one page per .sheet.
# Also crops the top of each PDF's first page into the social sharing image (og:image): img/og-fr.jpg, img/og-en.jpg.
set -euo pipefail

cd "$(dirname "$0")/.."

JEKYLL="${JEKYLL:-$(command -v jekyll || echo "$HOME/.gem/ruby/3.0.0/bin/jekyll")}"
CHROME="${CHROME:-$(command -v google-chrome || command -v chromium || command -v chromium-browser)}"
PORT="${PORT:-4010}"

WORK=$(mktemp -d)
SITE="$WORK/site"
"$JEKYLL" build --quiet --destination "$SITE"

python3 -m http.server "$PORT" --directory "$SITE" >/dev/null 2>&1 &
SERVER=$!
trap 'kill $SERVER 2>/dev/null; rm -r "$WORK"' EXIT
sleep 1

# Loads ?page=… in a same-origin iframe and reports, in the document title, the number of sheets and the
# smallest space left under the last block of a sheet (negative = clipped). Measured once the web fonts are
# in, as they change wrapping.
cat >"$SITE/__fit.html" <<'HTML'
<iframe id="page" style="width:1000px;height:1300px"></iframe>
<script>
  page.src = new URLSearchParams(location.search).get("page");
  page.onload = () =>
    page.contentDocument.fonts.ready.then(() => {
      const sheets = [...page.contentDocument.querySelectorAll(".sheet")];
      const spares = sheets.map((sheet) => {
        const bottom = sheet.getBoundingClientRect().bottom - parseFloat(getComputedStyle(sheet).paddingBottom);
        return bottom - sheet.lastElementChild.getBoundingClientRect().bottom;
      });
      document.title = "sheets=" + sheets.length + " spare=" + Math.floor(Math.min(...spares));
    });
</script>
HTML

chrome() { # headless Chrome with a fresh profile each run, so runs don't collide on the profile lock
  "$CHROME" --headless=new --disable-gpu --user-data-dir="$(mktemp -d -p "$WORK")" "$@" 2>/dev/null
}

print() { # <path> <output> <og image, without extension>
  fit=$(chrome --virtual-time-budget=10000 --dump-dom "http://localhost:$PORT/__fit.html?page=$1")
  sheets=$(echo "$fit" | sed -n 's/.*<title>sheets=\([0-9]*\) .*/\1/p')
  spare=$(echo "$fit" | sed -n 's/.*<title>sheets=[0-9]* spare=\(-\{0,1\}[0-9]*\)<\/title>.*/\1/p')
  if [ -z "$spare" ]; then
    echo "✗ $1: couldn't measure the page (is Chrome working?)" >&2
    exit 1
  elif [ "$spare" -lt 0 ]; then
    echo "✗ $1: a page overflows its A4 sheet by ${spare#-}px: trim content or spacing, or move page_break" >&2
    exit 1
  fi

  chrome --no-pdf-header-footer --virtual-time-budget=6000 --print-to-pdf="$2" "http://localhost:$PORT$1"
  pages=$(pdfinfo "$2" | awk '/^Pages:/ {print $2}')
  if [ "$pages" != "$sheets" ]; then
    echo "✗ $2 has $pages pages, expected $sheets (one per .sheet)" >&2
    exit 1
  fi
  # 1200px wide: A4 is 8.27in, so 145.1 dpi. 1200×630 is the size social networks expect.
  pdftoppm -f 1 -l 1 -r 145.1 -x 0 -y 0 -W 1200 -H 630 -jpeg -jpegopt quality=85 -singlefile "$2" "$3"
  echo "✓ $2: $pages pages, ${spare}px left at the bottom of the fullest"
}

print / CV-Augustin-Riedinger-French.pdf img/og-fr
print /en/ CV-Augustin-Riedinger-English.pdf img/og-en
